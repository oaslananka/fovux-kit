  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "pnpm exec tsup",
    "dev": "pnpm exec tsup --watch",
    "format": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,json,mjs,js}\" \"*.{json,md,mjs,ts}\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,json,mjs,js}\" \"*.{json,md,mjs,ts}\"",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "typecheck": "tsc --noEmit",
    "lm-tools:generate": "python ../scripts/generate_studio_lm_tools.py",
    "lm-tools:check": "python ../scripts/generate_studio_lm_tools.py --check",
    "test": "pnpm exec vitest run",
    "test:unit": "pnpm exec vitest run test/suite --coverage",
    "test:e2e": "node test/e2e/run.mjs",
    "test:a11y": "pnpm exec vitest run test/suite/a11y",
    "coverage": "pnpm exec vitest run --coverage --coverage.thresholds.lines=85",
    "audit:prod": "pnpm audit --prod",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build && pnpm audit:prod",
    "package": "node ../scripts/package_vscode_extension.mjs --extension-dir . --out fovuxstudiokit.vsix",
    "check:bundle-size": "node scripts/check-bundle-size.js",
    "coverage:ci": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --reporter=default --reporter=junit --outputFile=coverage/junit.xml",
    "test:e2e:compile": "tsc -p test/e2e/tsconfig.json",
    "pretest:e2e": "pnpm run test:e2e:compile",
    "test:e2e:ci": "pnpm run build && pnpm run package && pnpm run test:e2e"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "4.1.7",
    "@vscode/test-electron": "3.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "mocha": "11.7.6",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
